---
import Main from "@layouts/main.astro";
import { getCollection } from "astro:content";
import IconRSS from "@assets/rss.svg";
import PhysicsLoader from "@components/physics_loader.astro";

const posts = await getCollection("blog");
---

<Main title="Blog">
  <Fragment slot="head">
    <PhysicsLoader />
  </Fragment>
  <div class="flex justify-between items-center">
    <h1 class="text-3xl font-bold">Blog</h1>
    <a href="/rss.xml" class="shrink-0 text-secondary">
      <IconRSS />
    </a>
  </div>
  <ul class="space-y-4">
    {
      posts.map((post) => (
        <li class="box min-w-xs md:min-w-sm">
          <a
            href={`/blog/${post.id}`}
            class="text-xl text-primary hover:text-(--text-primary)"
          >
            {post.data.title}
          </a>
          <p class="text-secondary">{post.data.description}</p>
          <p class="text-tertiary">
            {post.data.pubDate.toLocaleDateString(undefined, {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </p>
        </li>
      ))
    }
  </ul>
</Main>

<style is:inline>
  .box {
    padding: 1rem;
    width: max-content;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    border: 2px solid var(--text-tertiary);
    margin: 1px; /* Very small margin to improve visual separation */
    user-select: none;
    cursor: grab;
    touch-action: none;
    will-change: transform;
    visibility: hidden; /* Hidden until settled */
  }

  footer {
    padding-top: 1px !important;
  }
</style>
