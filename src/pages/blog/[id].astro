---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";
import Navbar from "../../components/navbar.astro";
import Footer from "../../components/footer.astro";
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ultrablob.me</title>
    <link rel="icon" type="image/x-icon" href="/icon.svg" />
  </head>

  <body class="w-full min-h-screen bg-primary">
    <Navbar />

    <main id="content" class="p-4 max-w-3xl mx-auto">
      <article
        class="prose prose-zinc dark:prose-invert mx-auto prose-code:before:content-none prose-code:after:content-none"
      >
        <h1 class="mb-4">{post.data.title}</h1>
        <p class="text-sm text-secondary">
          {
            new Date(post.data.pubDate).toLocaleDateString(undefined, {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </p>
        <div id="blog-content" class="text-justify text-pretty">
          <Content />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<script>
  import enUsPatterns from "hyphenation.en-us";
  import { createHyphenator } from "tex-linebreak";
  import { justifyContent } from "../../lib/fast-justify";

  performance.mark("start-justification");
  const hyphenate = createHyphenator(enUsPatterns);
  const article = document.querySelector("article")!;
  const paragraphs = Array.from(article.querySelectorAll("p"));
  justifyContent(paragraphs, hyphenate);
  const content = document.getElementById("blog-content")!;
  content.classList.remove("text-justify");
  performance.mark("end-justification");
  performance.measure(
    "justification",
    "start-justification",
    "end-justification",
  );
  console.log(
    "Justification time: " +
      performance.getEntriesByName("justification")[0].duration.toFixed(2) +
      "ms",
  );

  let lastWidth = 0;
  const observer = new ResizeObserver((entries) => {
    const newWidth = entries[0].contentRect.width;
    if (newWidth !== lastWidth) {
      lastWidth = newWidth;
      justifyContent(paragraphs, hyphenate);
    }
  });
  observer.observe(article);
</script>
