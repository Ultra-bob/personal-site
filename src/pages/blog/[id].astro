---
import Main from "@layouts/main.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);

const canonicalUrl = `https://ultrablob.me/blog/${post.id}`;
---

<Main title={post.data.title}>
  <Fragment slot="head">
    <meta name="description" content={post.data.description} />
    <meta name="author" content="Your Name" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="ultrablob.me RSS"
      href="/rss.xml"
    />

    <meta name="theme-color" content="#111111" />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ultrablob.me" />
    <!-- <meta property="og:image" content={ogImageUrl} /> -->
    <meta
      property="article:published_time"
      content={new Date(post.data.pubDate).toISOString()}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.data.title} />
    <meta name="twitter:description" content={post.data.description} />
    <!-- <meta name="twitter:image" content={ogImageUrl} /> -->
  </Fragment>

  <article
    aria-labelledby="post-title"
    class="prose prose-zinc dark:prose-invert mx-auto prose-code:before:content-none prose-code:after:content-none"
  >
    <header>
      <h1 id="post-title" class="mb-4">{post.data.title}</h1>
      <time
        datetime={new Date(post.data.pubDate).toISOString()}
        class="text-sm text-secondary"
      >
        {
          new Date(post.data.pubDate).toLocaleDateString(undefined, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
    </header>

    <div id="blog-content" class="text-justify text-pretty">
      <Content />
    </div>
  </article>
</Main>

<script>
  import enUsPatterns from "hyphenation.en-us";
  import { createHyphenator } from "tex-linebreak";
  import { justifyContent } from "@lib/fast-justify";

  performance.mark("start-justification");
  const hyphenate = createHyphenator(enUsPatterns);
  const article = document.querySelector("article")!;
  const paragraphs = Array.from(article.querySelectorAll("p"));
  justifyContent(paragraphs, hyphenate);
  const content = document.getElementById("blog-content")!;
  content.classList.remove("text-justify");
  performance.mark("end-justification");
  performance.measure(
    "justification",
    "start-justification",
    "end-justification",
  );
  console.log(
    "Justification time: " +
      performance.getEntriesByName("justification")[0].duration.toFixed(2) +
      "ms",
  );

  let lastWidth = 0;
  const observer = new ResizeObserver((entries) => {
    const newWidth = entries[0].contentRect.width;
    if (newWidth !== lastWidth) {
      lastWidth = newWidth;
      justifyContent(paragraphs, hyphenate);
    }
  });
  observer.observe(article);
</script>
