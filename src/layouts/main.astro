---
import "@styles/global.css";
import Navbar from "@components/navbar.astro";
import Footer from "@components/footer.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} | ` : ""} ultrablob.me</title>
    <link rel="icon" type="image/x-icon" href="/icon.svg" />
    <slot name="head" />
  </head>

  <body class="w-full min-h-screen bg-primary flex flex-col items-center">
    <Navbar />

    <main id="content" class="p-4 max-sm:pt-0 max-w-3xl w-full">
      <slot />
    </main>

    <div class="grow"></div>

    <Footer />
  </body>
</html>
