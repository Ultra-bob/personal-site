---
import "../styles/global.css";

const { title, description, link, codeLink } = Astro.props;
---

<div class="flex flex-row items-start justify-between gap-4 mb-4">
    <h3 class="font-bold">{title}</h3>
    <p class="text-gray-500">{description}</p>
    <div class="flex-grow-1"></div>
    {link && (
        <a href={link} class="w-6 h-6 text-gray-500" aria-label="Visit project">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-external-link"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /><path d="M11 13l9 -9" /><path d="M15 4h5v5" /></svg>
        </a>
    )}
    {codeLink && (
        <a href={codeLink} class="w-6 h-6 text-gray-500" aria-label="View source code">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-code"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M7 8l-4 4l4 4" /><path d="M17 8l4 4l-4 4" /><path d="M14 4l-4 16" /></svg>
        </a>
    )}
</div>