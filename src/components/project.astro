---
import "../styles/global.css";
import LinkExternal from "../assets/link-external.svg";
import Code from "../assets/source-code.svg";

const { title, description, link, codeLink } = Astro.props;
---

<div class="flex flex-row items-start justify-between gap-4 mb-4">
    <h3 class="font-medium">{title}</h3>
    <p class="text-secondary">{description}</p>
    <div class="flex-grow-1"></div>
    {link && (
        <a href={link} class="w-6 h-6 flex-shrink-0 text-secondary" aria-label="Visit project">
            <LinkExternal />
        </a>
    )}
    {codeLink && (
        <a href={codeLink} class="w-6 h-6 flex-shrink-0 text-secondary" aria-label="View source code">
            <Code />
        </a>
    )}
</div>