---
import "../styles/global.css";
import LinkExternal from "../assets/link-external.svg";
import Code from "../assets/source-code.svg";

const { title, description, link, codeLink } = Astro.props;
---

<div class="flex flex-col items-start justify-between gap-4 mb-4 box max-w-sm">
    <div class="flex flex-row justify-between items-center gap-4 w-full">
        <h3 class="font-medium">{title}</h3>
        <div class="grow"></div>
        {link && (
            <a href={link} class="w-6 h-6 shrink-0 text-secondary" aria-label="Visit project">
                <LinkExternal />
            </a>
        )}
        {codeLink && (
            <a href={codeLink} class="w-6 h-6 shrink-0 text-secondary" aria-label="View source code">
                <Code />
            </a>
        )}
    </div>
    <p class="text-secondary text-balance">{description}</p>
</div>